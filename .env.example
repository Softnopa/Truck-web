# Publishable (anon) key only. RLS is what protects the data.
# The service_role / secret key must never appear in this app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Public — just the @username, used to build t.me invite links. The bot token
# itself is a secret and lives only in the Supabase Edge Function environment
# (Dashboard -> Edge Functions -> secrets), never here.
EXPO_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot_username
