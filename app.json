{
  "expo": {
    "name": "Truck",
    "slug": "truck-app",
    "version": "2.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "truckapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fruittruck.manager",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification",
          "location",
          "fetch"
        ]
      }
    },
    "android": {
      "package": "com.fruittruck.manager",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0F14"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Truck shares your location with the business owners continuously, including in the background, so they can see where you are on their map.",
          "locationWhenInUsePermission": "Truck shares your location with the business owners continuously, including in the background, so they can see where you are on their map.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "iosDisplayInForeground": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F5F8FB",
          "dark": {
            "image": "./assets/splash.png",
            "backgroundColor": "#0B0F14"
          }
        }
      ],
      "expo-font",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6b3e742d-241d-4ed4-84ff-5b5624e1ea7e"
      }
    },
    "owner": "aziz090982"
  }
}
